# Match the PyTorch commit used by the existing validated HF environment.
ARG HF_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.03-py3
FROM ${HF_BASE_IMAGE}
WORKDIR /workspace/CENO
COPY requirements.txt /workspace/CENO/requirements.txt
RUN env -u PIP_CONSTRAINT python3 -m pip install --no-cache-dir \
    -r requirements.txt bioframe pyBigWig datasets openpyxl pyliftover packaging ninja
ARG MAX_JOBS=4
RUN env -u PIP_CONSTRAINT MAX_JOBS=${MAX_JOBS} \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE MAMBA_FORCE_BUILD=TRUE FLASH_ATTENTION_FORCE_BUILD=TRUE \
    python3 -m pip install --no-cache-dir --no-build-isolation \
    causal-conv1d==1.2.2.post1 mamba-ssm==2.2.4 flash-attn==2.7.3
COPY . /workspace/CENO
RUN python3 -c "from importlib.metadata import version; assert version('transformers') == '4.48.3'; assert version('mamba-ssm') == '2.2.4'; assert version('flash-attn') == '2.7.3'"
